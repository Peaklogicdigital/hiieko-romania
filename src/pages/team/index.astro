---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import TeamCard from '../../components/TeamCard.astro';
import { getTranslations } from '../../i18n/ui';

const lang = 'en' as const;
const t = getTranslations(lang);

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={t.meta.team.title}
  description={t.meta.team.description}
  ogType="website"
  lang={lang}
>
  <section class="py-[100px]">
    <div class="wrap reveal">
      <div class="max-w-[640px] mb-[52px]">
        <Eyebrow text={t.team.eyebrow} />
        <h1 class="text-[clamp(30px,3.6vw,44px)] mt-2.5 mb-3.5">
          {t.team.h1}
        </h1>
        <p class="text-muted text-[15.5px]">
          {t.team.lede}
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[22px]">
        {
          team.map((member) => (
            <TeamCard
              name={member.data.name}
              role={member.data.role}
              phone={member.data.phone}
              email={member.data.email}
              photo={member.data.photo}
              isPlaceholder={member.data.isPlaceholder}
              placeholderBadge={t.common.placeholderBadge}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
