---
// Draft — this entire page is placeholder legal content pending sign-off
// by counsel before launch. Do not treat any of this copy as final.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { getTranslations, PRIVACY_ADDRESS_MAPS_URL } from '../../i18n/ui';

const lang = 'en' as const;
const t = getTranslations(lang);
---

<BaseLayout
  title={t.meta.privacy.title}
  description={t.meta.privacy.description}
  ogType="website"
  lang={lang}
>
  <section class="py-[100px]">
    <div class="wrap reveal max-w-[760px]">
      <Eyebrow text={t.privacy.eyebrow} />
      <h1 class="text-[clamp(30px,3.6vw,44px)] mt-2.5 mb-10">{t.privacy.h1}</h1>

      <div class="prose-content text-white">
        <div>
          <h2>{t.privacy.whoWeAreHeading}</h2>
          <p>
            {t.privacy.whoWeArePrefix}{' '}
            <a href={PRIVACY_ADDRESS_MAPS_URL} target="_blank" rel="noopener noreferrer">
              {t.privacy.whoWeAreAddressText}
            </a>, {t.privacy.whoWeAreSuffix}
          </p>
        </div>

        {
          t.privacy.sections.map((section) => (
            <div>
              <h2>{section.heading}</h2>
              <p>{section.body}</p>
            </div>
          ))
        }

        <div>
          <h2>{t.privacy.transfersHeading}</h2>
          <p>{t.privacy.transfersBody}</p>
          <!--
            TODO (legal): name the specific safeguard mechanism that applies
            to any processor based outside the EU/EEA (e.g. Standard
            Contractual Clauses) and confirm with counsel before launch.
          -->
        </div>

        <div>
          <h2>{t.privacy.rightsHeading}</h2>
          <p>
            {t.privacy.rightsIntro}{' '}
            <a href={`mailto:${t.privacy.rightsEmail}`}>{t.privacy.rightsEmail}</a>{t.privacy.rightsMiddle}{' '}
            <a href="https://www.dataprotection.ro" target="_blank" rel="noopener noreferrer">
              {t.privacy.rightsLinkLabel}
            </a>.
          </p>
        </div>

        <div>
          <h2>{t.privacy.changesHeading}</h2>
          <p>{t.privacy.changesBody}</p>
        </div>

        <!--
          New content, drafted separately from the Privacy Policy text above —
          the Privacy Policy content is lawyer-approved and final and is not
          touched by this section. This Cookie section is pending legal
          review before launch.
        -->
        <div>
          <h2>{t.privacy.cookies.heading}</h2>
          {
            t.privacy.cookies.sections.map((section) => (
              <div>
                <h3>{section.heading}</h3>
                <p>{section.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-size: 22px;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-content :global(h3) {
    font-size: 16.5px;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-content :global(p) {
    color: var(--color-muted);
    font-size: 15.5px;
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .prose-content :global(a) {
    color: var(--color-gold);
    text-decoration: underline;
  }
</style>
