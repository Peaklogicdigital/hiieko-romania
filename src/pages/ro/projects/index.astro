---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import ProjectsGallery from '../../../components/ProjectsGallery.astro';
import { getTranslations } from '../../../i18n/ui';

const lang = 'ro' as const;
const t = getTranslations(lang);
---

<BaseLayout
  title={t.meta.projects.title}
  description={t.meta.projects.description}
  ogType="website"
  lang={lang}
>
  <section class="py-[100px]">
    <div class="wrap reveal">
      <div class="max-w-[640px] mb-[52px]">
        <Eyebrow text={t.projectsPage.eyebrow} />
        <h1 class="text-[clamp(30px,3.6vw,44px)] mt-2.5 mb-3.5">{t.projectsPage.h1}</h1>
        <p class="text-muted text-[15.5px]">
          {t.projectsPage.lede}
        </p>
      </div>
      <ProjectsGallery filterable lang={lang} />
    </div>
  </section>
</BaseLayout>
