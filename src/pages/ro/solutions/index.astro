---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import SolutionsGrid from '../../../components/SolutionsGrid.astro';
import PerformanceSection from '../../../components/PerformanceSection.astro';
import WhyHiiekoSection from '../../../components/WhyHiiekoSection.astro';
import { getTranslations } from '../../../i18n/ui';

const lang = 'ro' as const;
const t = getTranslations(lang);
---

<BaseLayout
  title={t.meta.solutions.title}
  description={t.meta.solutions.description}
  ogType="website"
  lang={lang}
>
  <section class="py-[100px]">
    <div class="wrap reveal">
      <div class="max-w-[640px] mb-[52px]">
        <Eyebrow text={t.solutionsPage.eyebrow} />
        <h1 class="text-[clamp(30px,3.6vw,44px)] mt-2.5 mb-3.5">{t.solutionsPage.h1}</h1>
        <p class="text-muted text-[15.5px]">
          {t.solutionsPage.lede}
        </p>
      </div>
      <SolutionsGrid lang={lang} />
    </div>
  </section>

  <PerformanceSection lang={lang} />

  <WhyHiiekoSection lang={lang} />
</BaseLayout>
