---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import Certifications from '../../../components/Certifications.astro';
import TechPartnersSection from '../../../components/TechPartnersSection.astro';
import { getTranslations } from '../../../i18n/ui';

const lang = 'ro' as const;
const t = getTranslations(lang);
---

<BaseLayout
  title={t.meta.about.title}
  description={t.meta.about.description}
  ogType="website"
  lang={lang}
>
  <section class="py-[100px]">
    <div class="wrap reveal grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div>
        <Eyebrow text={t.about.eyebrow} />
        <h1 class="text-[clamp(30px,3.6vw,44px)] mt-2.5 mb-[18px]">
          {t.about.heading}
        </h1>
        <p class="text-muted text-[15.5px] mb-4">
          {t.about.para1}
        </p>
        <p class="text-muted text-[15.5px] mb-4">
          {t.about.para2}
        </p>
        <p class="text-muted text-[15.5px] mb-4">
          {t.about.para3Page}
          <a href="/ro/team/" class="text-gold underline">{t.about.readMoreTeamLink}</a>
        </p>
        <div class="mt-[26px]">
          <Certifications lang={lang} />
        </div>
      </div>
      <div class="bg-chip border border-white/10 rounded-md">
        <div class="p-5 px-[22px] border-b border-white/10 flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.founded.label}</span>
          <span class="font-mono font-semibold text-gold-bright">{t.about.figs.founded.value}</span>
        </div>
        <div class="p-5 px-[22px] border-b border-white/10 flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.subsidiary.label}</span>
          <span class="font-mono font-semibold text-gold-bright">{t.about.figs.subsidiary.value}</span>
        </div>
        <div class="p-5 px-[22px] border-b border-white/10 flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.purpose.label}</span>
          <span class="font-mono font-semibold text-gold-bright">{t.about.figs.purpose.value}</span>
        </div>
        <div class="p-5 px-[22px] border-b border-white/10 flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.localTeam.label}</span>
          <span class="font-mono font-semibold text-gold-bright">{t.about.figs.localTeam.value}</span>
        </div>
        <div class="p-5 px-[22px] border-b border-white/10 flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.certification.label}</span>
          <span class="font-mono font-semibold text-gold-bright">{t.about.figs.certification.value}</span>
        </div>
        <div class="p-5 px-[22px] flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.address.label}</span>
          <span class="font-mono font-semibold text-gold-bright text-right">{t.about.figs.address.value}</span>
        </div>
      </div>
    </div>
  </section>

  <TechPartnersSection lang={lang} />
</BaseLayout>
