---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import TeamCard from '../../../components/TeamCard.astro';
import { getTranslations } from '../../../i18n/ui';

const lang = 'ro' as const;
const t = getTranslations(lang);

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

// Draft AI-assisted translation of team role titles, pending native-speaker
// review before launch. The team collection itself stays English-only (see
// comment below); this lookup translates just the `role` field for this page.
const roleLabels: Record<string, string> = {
  'Supervisory Board Member, Business Associate, Administrator':
    'Membru al Consiliului de Supraveghere, Asociat de Afaceri, Administrator',
  'Field Leader': 'Șef de echipă teren',
  'Business Development Representative': 'Reprezentant Dezvoltare Afaceri',
  'Client Analyst': 'Analist Clienți',
  'Planning Group Leader': 'Șef Grup Planificare',
  'Engineer & Budgeting and Pricing Analyst': 'Inginer și Analist Bugetare și Prețuri',
  'Head of Budgeting': 'Șef Departament Bugetare',
  'New Business Developer': 'Dezvoltator Afaceri Noi',
  'Project Manager': 'Manager de Proiect',
  'Process and Project Manager': 'Manager Procese și Proiecte',
};
---

<BaseLayout
  title={t.meta.team.title}
  description={t.meta.team.description}
  ogType="website"
  lang={lang}
>
  <section class="py-[100px]">
    <div class="wrap">
      <div class="max-w-[640px] mb-[52px] reveal">
        <Eyebrow text={t.team.eyebrow} />
        <h1 class="text-[clamp(30px,3.6vw,44px)] mt-2.5 mb-3.5">
          {t.team.h1}
        </h1>
        <p class="text-muted text-[15.5px]">
          {t.team.lede}
        </p>
      </div>
      <!-- Team member names, photos, phone, and email come from the content
           collection and render as-is (they aren't language-specific). Only
           `role` is translated, via the roleLabels lookup above. -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[22px]">
        {
          team.map((member) => (
            <TeamCard
              name={member.data.name}
              role={roleLabels[member.data.role] ?? member.data.role}
              phone={member.data.phone}
              email={member.data.email}
              photo={member.data.photo}
              isPlaceholder={member.data.isPlaceholder}
              placeholderBadge={t.common.placeholderBadge}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
