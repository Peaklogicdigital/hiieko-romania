---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import DashboardSchematic from '../components/DashboardSchematic.astro';
import TrustStrip from '../components/TrustStrip.astro';
import DifferentiationSection from '../components/DifferentiationSection.astro';
import SolutionsGrid from '../components/SolutionsGrid.astro';
import Calculator from '../components/Calculator.astro';
import ProjectsGallery from '../components/ProjectsGallery.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Hiieko Romania — Industrial Solar & Energy Storage"
  description="Design, installation, and long-term maintenance of rooftop and ground-mount solar plus battery storage for Romanian industrial and commercial sites — one contractor, one guarantee, backed by Estonian engineering since 1994."
  ogType="website"
>
  <header class="pt-20 overflow-hidden relative">
    <div
      class="absolute inset-0 z-0 pointer-events-none"
      style="background: radial-gradient(600px 400px at 80% 10%, rgba(70,247,156,0.08), transparent 70%);"
    >
    </div>
    <div class="wrap relative z-10 grid grid-cols-1 md:grid-cols-[1.05fr_0.95fr] gap-10 items-center">
      <div>
        <Eyebrow text="Hiieko Romania — Industrial Solar & Storage" />
        <h1 class="text-[clamp(34px,4.4vw,54px)] leading-[1.05] my-[18px] mb-[22px]">
          We don't sell panels. We deliver a system and stand behind it.
        </h1>
        <p class="text-[17px] text-muted max-w-[48ch] mb-8">
          Design, installation, and long-term maintenance of rooftop and ground-mount solar plus
          battery storage for Romanian industrial and commercial sites — one contractor, one
          guarantee, backed by Estonian engineering since 1994.
        </p>
        <div class="flex gap-3.5 flex-wrap mb-14">
          <Button variant="primary" href="/contact/">Get a site assessment →</Button>
          <Button variant="ghost" href="/#calculator">Estimate your system ↓</Button>
        </div>
      </div>

      <div class="bg-bg-2 border border-line rounded-md p-[22px] reveal">
        <div class="flex justify-between items-center mb-3.5">
          <span class="font-mono text-[11px] text-muted tracking-[0.06em] uppercase">
            System overview
          </span>
          <Eyebrow text="Live" small />
        </div>
        <DashboardSchematic />
      </div>
    </div>

    <TrustStrip />
  </header>

  <DifferentiationSection />

  <section class="bg-bg-2 py-[100px]" id="solutions">
    <div class="wrap reveal">
      <div class="max-w-[640px] mb-[52px]">
        <Eyebrow text="What we build" />
        <h2 class="text-[clamp(26px,3vw,36px)] mt-2.5 mb-3.5">Three systems. One team.</h2>
        <p class="text-muted text-[15.5px]">
          For industrial platforms, logistics halls, production facilities, and unused land.
        </p>
      </div>
      <SolutionsGrid />
    </div>
  </section>

  <Calculator />

  <section id="projects" class="py-[100px]">
    <div class="wrap reveal">
      <div class="max-w-[640px] mb-[52px]">
        <Eyebrow text="Projects" />
        <h2 class="text-[clamp(26px,3vw,36px)] mt-2.5 mb-3.5">What we've built.</h2>
        <p class="text-muted text-[15.5px]">
          A sample of completed work. <a href="/projects/" class="text-neon underline">See all projects →</a>
        </p>
      </div>
      <ProjectsGallery limit={3} />
    </div>
  </section>

  <section class="bg-bg-2 py-[100px]" id="about">
    <div class="wrap reveal grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div>
        <Eyebrow text="Why Hiieko" />
        <h2 class="text-[clamp(24px,2.8vw,32px)] mt-2.5 mb-[18px]">
          Estonian engineering, delivered locally.
        </h2>
        <p class="text-muted text-[15.5px] mb-4">
          Hiieko Romania SRL is part of the Estonian Hiieko group, which has designed, installed,
          and maintained construction technical systems since 1994. In Romania, that same
          engineering discipline was applied to a purpose-built subsidiary, established in 2020
          specifically to develop industrial solar parks and storage facilities.
        </p>
        <p class="text-muted text-[15.5px] mb-4">
          We're not a panel installer that appeared last year. We're part of a group with three
          decades of execution on complex sites — and a Romanian team that stays accountable after
          handover.
        </p>
        <a href="/about/" class="text-neon underline text-sm">Read more about Hiieko →</a>
        <div class="flex gap-3.5 mt-[26px]">
          <div class="border border-line rounded-[2px] px-3.5 py-2.5 font-mono text-xs flex items-center gap-2">
            <span class="w-[7px] h-[7px] rounded-full bg-neon shadow-[0_0_6px_var(--color-neon)]"></span>
            ISO 9001:2015
          </div>
          <div class="border border-line rounded-[2px] px-3.5 py-2.5 font-mono text-xs flex items-center gap-2">
            <span class="w-[7px] h-[7px] rounded-full bg-neon shadow-[0_0_6px_var(--color-neon)]"></span>
            ISO 14001:2015
          </div>
        </div>
      </div>
      <div class="bg-bg border border-line rounded-md">
        <div class="p-5 px-[22px] border-b border-line flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">Group founded</span>
          <span class="font-mono font-semibold text-volt">1994, Tallinn</span>
        </div>
        <div class="p-5 px-[22px] border-b border-line flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">Romania subsidiary established</span>
          <span class="font-mono font-semibold text-volt">2020</span>
        </div>
        <div class="p-5 px-[22px] border-b border-line flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">Purpose</span>
          <span class="font-mono font-semibold text-volt">Solar parks + storage</span>
        </div>
        <div class="p-5 px-[22px] border-b border-line flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">Local team</span>
          <span class="font-mono font-semibold text-volt">21 specialists</span>
        </div>
        <div class="p-5 px-[22px] flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">Certification</span>
          <span class="font-mono font-semibold text-volt">ISO 9001 / 14001</span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-[100px]" id="contact">
    <div class="wrap reveal grid grid-cols-1 md:grid-cols-[0.9fr_1.1fr] gap-14">
      <div>
        <Eyebrow text="Next step" />
        <h2 class="text-[clamp(26px,3vw,34px)] mt-2.5 mb-4">Request a site assessment.</h2>
        <p class="text-muted text-[15px] max-w-[38ch]">
          Send a few details about the site and consumption. You'll get a sizing estimate back —
          not a sales pitch.
        </p>
        <div class="mt-7 text-sm text-muted">
          <div class="mb-2"><b class="text-text">Hiieko Romania SRL</b></div>
          <div class="mb-2">Bd. Theodor Pallady 51N, Sector 3, Bucharest</div>
          <div class="mb-2">[[ RO contact email ]] · [[ RO phone ]]</div>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
