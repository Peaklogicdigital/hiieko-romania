---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import HeroSchematic from '../components/HeroSchematic.astro';
import TrustStrip from '../components/TrustStrip.astro';
import DifferentiationSection from '../components/DifferentiationSection.astro';
import SolutionsGrid from '../components/SolutionsGrid.astro';
import IndustriesSection from '../components/IndustriesSection.astro';
import Calculator from '../components/Calculator.astro';
import ProjectsGallery from '../components/ProjectsGallery.astro';
import ContactForm from '../components/ContactForm.astro';
import { getTranslations } from '../i18n/ui';

const lang = 'en' as const;
const t = getTranslations(lang);
---

<BaseLayout
  title={t.meta.home.title}
  description={t.meta.home.description}
  ogType="website"
  lang={lang}
>
  <header class="pt-20 overflow-hidden relative">
    <div class="wrap relative z-10 grid grid-cols-1 md:grid-cols-[1fr_1.15fr] gap-10 items-center">
      <div>
        <Eyebrow text={t.hero.eyebrow} />
        <h1 class="text-[clamp(34px,4.4vw,54px)] leading-[1.05] my-[18px] mb-[22px]">
          {t.hero.h1}
        </h1>
        <p class="text-[17px] text-muted max-w-[48ch] mb-8">
          {t.hero.lede}
        </p>
        <div class="flex gap-3.5 flex-wrap mb-14">
          <Button variant="primary" href="/contact/">{t.hero.ctaPrimary}</Button>
          <Button variant="ghost" href="/#calculator">{t.hero.ctaSecondary}</Button>
        </div>
      </div>

      <HeroSchematic />
    </div>

    <TrustStrip lang={lang} />
  </header>

  <DifferentiationSection lang={lang} />

  <section class="py-[100px]" id="solutions">
    <div class="wrap reveal">
      <div class="max-w-[640px] mb-[52px]">
        <Eyebrow text={t.solutionsHome.eyebrow} />
        <h2 class="text-[clamp(26px,3vw,36px)] mt-2.5 mb-3.5">{t.solutionsHome.h2}</h2>
        <p class="text-muted text-[15.5px]">
          {t.solutionsHome.lede}
        </p>
      </div>
      <SolutionsGrid lang={lang} />
    </div>
  </section>

  <IndustriesSection lang={lang} />

  <Calculator lang={lang} />

  <section id="projects" class="py-[100px]">
    <div class="wrap reveal">
      <div class="max-w-[640px] mb-[52px]">
        <Eyebrow text={t.projectsHome.eyebrow} />
        <h2 class="text-[clamp(26px,3vw,36px)] mt-2.5 mb-3.5">{t.projectsHome.h2}</h2>
        <p class="text-muted text-[15.5px]">
          {t.projectsHome.ledePrefix} <a href="/projects/" class="text-gold underline">{t.projectsHome.seeAllLink}</a>
        </p>
      </div>
      <ProjectsGallery limit={3} lang={lang} />
    </div>
  </section>

  <section class="py-[100px]" id="about">
    <div class="wrap reveal grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div>
        <Eyebrow text={t.about.eyebrow} />
        <h2 class="text-[clamp(24px,2.8vw,32px)] mt-2.5 mb-[18px]">
          {t.about.heading}
        </h2>
        <p class="text-muted text-[15.5px] mb-4">
          {t.about.para1}
        </p>
        <p class="text-muted text-[15.5px] mb-4">
          {t.about.para2}
        </p>
        <a href="/about/" class="text-gold underline text-sm">{t.about.readMoreLink}</a>
        <div class="flex gap-3.5 mt-[26px]">
          <div class="border border-white/10 rounded-[2px] px-3.5 py-2.5 font-mono text-xs flex items-center gap-2">
            <span class="w-[7px] h-[7px] rounded-full bg-gold shadow-[0_0_6px_var(--color-gold)]"></span>
            {t.about.iso1}
          </div>
          <div class="border border-white/10 rounded-[2px] px-3.5 py-2.5 font-mono text-xs flex items-center gap-2">
            <span class="w-[7px] h-[7px] rounded-full bg-gold shadow-[0_0_6px_var(--color-gold)]"></span>
            {t.about.iso2}
          </div>
        </div>
      </div>
      <div class="bg-chip border border-white/10 rounded-md">
        <div class="p-5 px-[22px] border-b border-white/10 flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.founded.label}</span>
          <span class="font-mono font-semibold text-gold-bright">{t.about.figs.founded.value}</span>
        </div>
        <div class="p-5 px-[22px] border-b border-white/10 flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.subsidiary.label}</span>
          <span class="font-mono font-semibold text-gold-bright">{t.about.figs.subsidiary.value}</span>
        </div>
        <div class="p-5 px-[22px] border-b border-white/10 flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.purpose.label}</span>
          <span class="font-mono font-semibold text-gold-bright">{t.about.figs.purpose.value}</span>
        </div>
        <div class="p-5 px-[22px] border-b border-white/10 flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.localTeam.label}</span>
          <span class="font-mono font-semibold text-gold-bright">{t.about.figs.localTeam.value}</span>
        </div>
        <div class="p-5 px-[22px] flex justify-between items-baseline">
          <span class="text-[13.5px] text-muted">{t.about.figs.certification.label}</span>
          <span class="font-mono font-semibold text-gold-bright">{t.about.figs.certification.value}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-[100px]" id="contact">
    <div class="wrap reveal grid grid-cols-1 md:grid-cols-[0.9fr_1.1fr] gap-14">
      <div>
        <Eyebrow text={t.contact.eyebrow} />
        <h2 class="text-[clamp(26px,3vw,34px)] mt-2.5 mb-4">{t.contact.heading}</h2>
        <p class="text-muted text-[15px] max-w-[38ch]">
          {t.contact.lede}
        </p>
        <div class="mt-7 text-sm text-muted">
          <div class="mb-2"><b class="text-white">{t.contact.companyName}</b></div>
          <div class="mb-2">{t.contact.addressLine}</div>
          <div class="mb-2">{t.contact.email}</div>
        </div>
      </div>
      <ContactForm lang={lang} />
    </div>
  </section>
</BaseLayout>
