---
// Astro's standard catch-all 404 page. Static output means this file is
// pre-rendered once at build time and served for any unmatched path by
// the host (Astro's own preview server does the same) — there's no
// per-request way to know at render time whether the visitor hit a
// missing /ro/ URL or a missing EN one. So both language versions are
// rendered here, and a tiny inline script picks the right one at runtime
// based on the actual browser URL — simplest option that still routes
// correctly, without a bigger request-time i18n mechanism.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { getTranslations, defaultLang } from '../i18n/ui';

const en = getTranslations('en');
const ro = getTranslations('ro');
---

<BaseLayout title="404 — Hiieko Romania" description="Page not found." lang={defaultLang}>
  <section class="py-[140px]">
    <div class="wrap reveal max-w-[640px] mx-auto text-center">
      <div class="font-mono text-[110px] leading-none font-extrabold text-line select-none" aria-hidden="true">
        404
      </div>

      <div data-lang-block="en">
        <div
          class="inline-flex items-center gap-2 font-mono text-[11px] text-muted uppercase tracking-[0.08em] mb-5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-muted"></span>
          {en.notFound.badge}
        </div>
        <h1 class="text-[clamp(26px,3.4vw,38px)] mb-4">{en.notFound.headline}</h1>
        <p class="text-muted text-[15.5px] mb-8 max-w-[46ch] mx-auto">{en.notFound.lede}</p>
        <div class="flex justify-center mb-7">
          <Button variant="primary" href="/">{en.notFound.ctaHome}</Button>
        </div>
        <div class="flex justify-center gap-6 text-sm">
          <a href="/solutions/" class="text-neon underline">{en.notFound.linkSolutions}</a>
          <a href="/projects/" class="text-neon underline">{en.notFound.linkProjects}</a>
          <a href="/contact/" class="text-neon underline">{en.notFound.linkContact}</a>
        </div>
      </div>

      <div data-lang-block="ro" class="hidden">
        <div
          class="inline-flex items-center gap-2 font-mono text-[11px] text-muted uppercase tracking-[0.08em] mb-5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-muted"></span>
          {ro.notFound.badge}
        </div>
        <h1 class="text-[clamp(26px,3.4vw,38px)] mb-4">{ro.notFound.headline}</h1>
        <p class="text-muted text-[15.5px] mb-8 max-w-[46ch] mx-auto">{ro.notFound.lede}</p>
        <div class="flex justify-center mb-7">
          <Button variant="primary" href="/ro/">{ro.notFound.ctaHome}</Button>
        </div>
        <div class="flex justify-center gap-6 text-sm">
          <a href="/ro/solutions/" class="text-neon underline">{ro.notFound.linkSolutions}</a>
          <a href="/ro/projects/" class="text-neon underline">{ro.notFound.linkProjects}</a>
          <a href="/ro/contact/" class="text-neon underline">{ro.notFound.linkContact}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  if (location.pathname.startsWith('/ro/')) {
    document.querySelector('[data-lang-block="en"]')?.classList.add('hidden');
    document.querySelector('[data-lang-block="ro"]')?.classList.remove('hidden');
    document.documentElement.lang = 'ro';
  }
</script>
