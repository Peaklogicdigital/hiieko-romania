---
import { getCollection, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import TechPartnerGroup from '../../components/TechPartnerGroup.astro';
import PerformanceSection from '../../components/PerformanceSection.astro';
import VideoBackground from '../../components/VideoBackground.astro';
import rooftopPoster from '../../assets/video-posters/rooftop.jpg';
import groundMountPoster from '../../assets/video-posters/ground-mount-aerial.jpg';
import evChargingPoster from '../../assets/video-posters/ev-charging.jpg';
import { getTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const lang = 'en' as const;
const t = getTranslations(lang);

// Which of techPartners.groups (panels/inverters/storage/infrastructure, in
// that fixed order) actually applies to each system type -- matched by
// index rather than the translated heading text so this doesn't couple to
// wording. Ground-mount also gets grid-connection infrastructure since it
// deals with utility-scale interconnection that rooftop self-consumption
// systems don't.
const techGroupIndices: Record<string, number[]> = {
  'rooftop-solar': [0, 1],
  'ground-mount-solar-parks': [0, 1, 3],
  'battery-storage-bess': [2, 1],
};
const relevantGroups = (techGroupIndices[service.id] ?? []).map((i) => t.techPartners.groups[i]);

// The panel degradation curve (and its accompanying yield/efficiency
// stats) describes photovoltaic output over 30 years -- it doesn't apply
// to a standalone battery installation, which has no panels and no
// comparable "year 30" output metric.
const showPerformance = service.id === 'rooftop-solar' || service.id === 'ground-mount-solar-parks';
---

<BaseLayout
  title={`${service.data.title} · Hiieko Romania`}
  description={service.data.summary}
  ogType="website"
  lang={lang}
>
  <section class="py-[100px]">
    <div class="wrap reveal">
      <div class="max-w-[760px]">
        <Eyebrow text={`${t.solutionDetail.eyebrowPrefix} ${service.data.tagNumber}`} />
        <h1 class="text-[clamp(30px,3.6vw,44px)] mt-2.5 mb-3.5">{service.data.title}</h1>
        <p class="text-muted text-[15.5px] mb-10">{service.data.summary}</p>
      </div>

      {
        service.id === 'rooftop-solar' && (
          <VideoBackground
            src="/videos/rooftop.mp4"
            poster={rooftopPoster}
            alt={t.solutionDetail.rooftopVideoAlt}
            filter="saturate(1.15) sepia(0.18) hue-rotate(-6deg) brightness(1.04)"
            class="relative aspect-video md:aspect-[21/9] rounded-md mb-10"
          />
        )
      }
      {
        service.id === 'ground-mount-solar-parks' && (
          <VideoBackground
            src="/videos/ground-mount-aerial.mp4"
            poster={groundMountPoster}
            alt={t.solutionDetail.groundMountVideoAlt}
            class="relative aspect-video md:aspect-[21/9] rounded-md mb-10"
          />
        )
      }
      {
        service.id === 'ev-charging-infrastructure' && (
          <VideoBackground
            src="/videos/ev-charging.mp4"
            poster={evChargingPoster}
            alt={t.solutionDetail.evChargingVideoAlt}
            class="relative aspect-video md:aspect-[21/9] rounded-md mb-10"
          />
        )
      }

      <div class="max-w-[760px]">
        <div class="prose-content text-white">
          <Content />
        </div>

        {
          relevantGroups.length > 0 && (
            <div class="mt-12 border-t border-white/10 pt-10">
              <h2 class="text-[19px] text-white mb-6">{t.solutionDetail.equipmentHeading}</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-[26px] mb-6">
                {relevantGroups.map((group) => (
                  <TechPartnerGroup heading={group.heading} items={group.items} />
                ))}
              </div>
              <a href={`${getRelativeLocaleUrl(lang, '/about/')}#tech-partners`} class="text-gold underline text-sm">
                {t.solutionDetail.allPartnersLink}
              </a>
            </div>
          )
        }

        <div class="mt-12">
          <a href="/solutions/" class="text-gold underline text-sm">{t.solutionDetail.backLink}</a>
        </div>
      </div>
    </div>
  </section>

  {showPerformance && <PerformanceSection lang={lang} />}
</BaseLayout>
