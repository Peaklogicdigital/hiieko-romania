---
import StatBlock from './StatBlock.astro';
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getTranslations(lang);
---

<div class="py-14">
  <div class="wrap grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-[22px] gap-y-[22px]">
    <StatBlock value={t.trust.founded.value} label={t.trust.founded.label} />
    <StatBlock value="0" countTo={100} suffix="+" label={t.trust.capacity.label} />
    <StatBlock value="0" countTo={50} suffix="+" label={t.trust.happyClients.label} />
    <StatBlock value="0" countTo={25} suffix="+" label={t.trust.specialists.label} />
    <StatBlock value={t.trust.iso.value} label={t.trust.iso.label} />
  </div>
</div>

<script>
  import { initCountUpStats } from '../scripts/countUp';
  initCountUpStats();
</script>
