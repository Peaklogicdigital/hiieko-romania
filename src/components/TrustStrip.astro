---
import StatBlock from './StatBlock.astro';
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getTranslations(lang);
---

<div class="bg-bg-2 border-t border-b border-line">
  <div class="wrap grid grid-cols-2 md:grid-cols-4 gap-x-[18px] gap-y-[22px] py-[26px] px-[28px]">
    <StatBlock value={t.trust.founded.value} label={t.trust.founded.label} />
    <StatBlock value="0" countTo={100} suffix="+ MWp" label={t.trust.capacity.label} />
    <StatBlock value="0" countTo={25} suffix="+" label={t.trust.specialists.label} />
    <StatBlock value={t.trust.iso.value} label={t.trust.iso.label} />
  </div>
</div>

<script>
  import { initCountUpStats } from '../scripts/countUp';
  initCountUpStats();
</script>
