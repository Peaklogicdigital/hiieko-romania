---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getTranslations(lang);

const proofProjects = (await getCollection('projects'))
  .filter((p) => p.data.image)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<div class="py-14 border-t border-b border-white/10">
  <div class="wrap grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-10 items-center">
    <div class="flex items-center gap-5">
      <div class="flex -space-x-3 shrink-0">
        {
          proofProjects.map((project) => (
            <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-charcoal">
              <Image
                src={project.data.image!}
                alt=""
                width={112}
                height={112}
                class="w-full h-full object-cover"
              />
            </div>
          ))
        }
      </div>
      <div>
        <div class="font-mono text-gold-bright font-semibold text-[26px] leading-none">
          <span data-count="200">0</span>+ <span class="text-[16px] font-sans font-normal text-white">MWp</span>
        </div>
        <div class="text-muted text-[13px] mt-1.5">{t.trust.capacity.label}</div>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-x-6 border-t lg:border-t-0 lg:border-l border-white/10 pt-5 lg:pt-0 lg:pl-8">
      <div>
        <div class="font-mono text-gold-bright font-semibold text-[19px]"><span data-count="80">0</span>+</div>
        <div class="text-muted text-[12px] mt-0.5">{t.trust.happyClients.label}</div>
      </div>
      <div>
        <div class="font-mono text-gold-bright font-semibold text-[19px]"><span data-count="40">0</span>+</div>
        <div class="text-muted text-[12px] mt-0.5">{t.trust.specialists.label}</div>
      </div>
      <div>
        <div class="font-mono text-gold-bright font-semibold text-[19px]">{t.trust.iso.value}</div>
        <div class="text-muted text-[12px] mt-0.5">{t.trust.iso.label}</div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initCountUpStats } from '../scripts/countUp';
  initCountUpStats();
</script>
