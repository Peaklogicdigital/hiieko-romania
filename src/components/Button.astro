---
interface Props {
  variant?: 'primary' | 'ghost' | 'brand';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  id?: string;
}
const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
  id,
} = Astro.props;
const variantClass = { primary: 'btn-primary', ghost: 'btn-ghost', brand: 'btn-brand' }[variant];
const classes = ['btn', variantClass, className].join(' ');
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={href ? undefined : type} id={id}>
  <slot />
</Tag>
