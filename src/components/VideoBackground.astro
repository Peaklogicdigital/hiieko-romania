---
// Full-bleed/section background video: autoplay/muted/loop, with a static
// poster image as both the prefers-reduced-motion fallback and the
// autoplay-blocked fallback (Chrome's power-save heuristic can reject
// play() with an AbortError; when that happens there's no video frame to
// show, so we swap to the poster instead of leaving a blank box). This is
// the same retry/fallback shape the old hero video used: defer init until
// DOMContentLoaded if the script runs before it, call play(), and on
// rejection reveal the poster via a class toggle. reduced-motion itself is
// handled in CSS alone so it holds even if this script never runs.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  poster: ImageMetadata;
  alt: string;
  // Applied to both the video and its poster fallback via a CSS custom
  // property, so a color grade (e.g. Rooftop's warming filter) matches
  // whichever one is actually visible.
  filter?: string;
  class?: string;
  // Defaults suit a full-bleed section; a small rendered instance (e.g. a
  // grid card) should pass a narrower `sizes`/`widths` so its poster
  // fallback doesn't request full-viewport-width images, and `loading`
  // lazy since it's typically below the fold.
  sizes?: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  // Opt-in user-facing pause/play control (Web Interface Guidelines:
  // autoplay motion over 5s needs a pause/stop control). Left off by
  // default so small card-sized instances (e.g. SolutionCard's grid
  // thumbnails) stay exactly as they were -- only full-bleed section/page
  // banners pass this.
  pausable?: boolean;
  pauseLabel?: string;
  playLabel?: string;
}
const {
  src,
  poster,
  alt,
  filter,
  class: className,
  sizes = '100vw',
  widths = [640, 960, 1280, 1920],
  loading = 'eager',
  pausable = false,
  pauseLabel = 'Pause video',
  playLabel = 'Play video',
} = Astro.props;
---

<div
  class:list={['video-bg', className]}
  data-video-bg
  style={filter ? `--video-bg-filter: ${filter}` : undefined}
>
  <video
    class="video-bg-media"
    autoplay
    muted
    loop
    playsinline
    webkit-playsinline="true"
    preload="auto"
    aria-hidden="true"
    data-video-bg-el
  >
    <source src={src} type="video/mp4" />
  </video>

  <Picture
    src={poster}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    widths={widths}
    sizes={sizes}
    loading={loading}
    class="video-bg-fallback"
  />

  {
    pausable && (
      <button
        type="button"
        class="video-bg-toggle"
        data-video-bg-toggle
        data-pause-label={pauseLabel}
        data-play-label={playLabel}
        aria-label={pauseLabel}
      >
        <svg data-icon-pause xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <rect x="6" y="5" width="4" height="14" rx="1" />
          <rect x="14" y="5" width="4" height="14" rx="1" />
        </svg>
        <svg data-icon-play xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" class="hidden" aria-hidden="true">
          <path d="M7 5.5v13l12-6.5-12-6.5Z" />
        </svg>
      </button>
    )
  }

  <slot />
</div>

<script>
  function initVideoBackgrounds(): void {
    const containers = document.querySelectorAll<HTMLElement>('[data-video-bg]');

    containers.forEach((container) => {
      const video = container.querySelector('[data-video-bg-el]');
      if (!(video instanceof HTMLVideoElement)) return;

      const toggle = container.querySelector<HTMLButtonElement>('[data-video-bg-toggle]');
      if (toggle) {
        const iconPause = toggle.querySelector<SVGElement>('[data-icon-pause]');
        const iconPlay = toggle.querySelector<SVGElement>('[data-icon-play]');
        const pauseLabel = toggle.dataset.pauseLabel || 'Pause video';
        const playLabel = toggle.dataset.playLabel || 'Play video';

        const syncToggleUi = () => {
          const paused = video.paused;
          iconPause?.classList.toggle('hidden', paused);
          iconPlay?.classList.toggle('hidden', !paused);
          toggle.setAttribute('aria-label', paused ? playLabel : pauseLabel);
        };

        toggle.addEventListener('click', () => {
          if (video.paused) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });

        video.addEventListener('play', syncToggleUi);
        video.addEventListener('pause', syncToggleUi);
        syncToggleUi();
      }

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return; // CSS alone already shows the static poster.
      }

      const showFallback = () => container.classList.add('show-fallback');

      // Three distinct failure modes, none of which alone covers the
      // others: play() rejecting (Chrome's power-save heuristic throws
      // AbortError before any frame is requested), an outright network/
      // decode `error` event, and the quieter case where play() resolves
      // but no source was actually playable (e.g. an unsupported codec) --
      // readyState just never leaves HAVE_NOTHING and neither of the other
      // two ever fires. The timeout is that last safety net.
      video.addEventListener('error', showFallback);

      video.muted = true;
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(showFallback);
      }

      window.setTimeout(() => {
        if (video.readyState === HTMLMediaElement.HAVE_NOTHING) {
          showFallback();
        }
      }, 3000);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoBackgrounds);
  } else {
    initVideoBackgrounds();
  }
</script>

<style>
  .video-bg {
    /* No position here on purpose: the caller's `class` prop sets it
       (`relative` for an in-flow banner sized by aspect-ratio, `absolute
       inset-0` for a full-bleed background filling a positioned ancestor).
       Astro's scoping attribute makes a rule declared in this file's own
       <style> more specific than a plain utility class, so a `position`
       declared here would silently win over an `absolute` passed in via
       `class` regardless of source order -- exactly the kind of
       "invisible" component-vs-caller conflict that once collapsed the
       hero's video to 0 height. */
    overflow: hidden;
  }

  .video-bg-media,
  .video-bg-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--video-bg-filter, none);
  }

  .video-bg-fallback {
    display: none;
  }

  .video-bg.show-fallback .video-bg-media {
    display: none;
  }
  .video-bg.show-fallback .video-bg-fallback {
    display: block;
  }

  .video-bg-toggle {
    position: absolute;
    bottom: 14px;
    right: 14px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid rgb(250 251 247 / 0.2);
    background: rgb(30 35 31 / 0.55);
    backdrop-filter: blur(6px);
    color: var(--color-white);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background 0.15s ease;
  }
  .video-bg-toggle:hover,
  .video-bg-toggle:focus-visible {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }
  .video-bg-toggle:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
  .video-bg.show-fallback .video-bg-toggle {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .video-bg-media {
      display: none;
    }
    .video-bg-fallback {
      display: block;
    }
    .video-bg-toggle {
      display: none;
    }
  }
</style>
