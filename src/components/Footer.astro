---
const year = new Date().getFullYear();
---

<footer class="bg-bg-2 text-muted pt-12 pb-[30px] border-t border-line">
  <div
    class="wrap flex justify-between flex-wrap gap-[30px] border-b border-line pb-[34px] mb-[22px]"
  >
    <div>
      <h4 class="font-mono text-[11px] text-text uppercase tracking-[0.08em] mb-3">
        Hiieko Romania
      </h4>
      <div class="text-[13.5px] mb-1.5">Bd. Theodor Pallady 51N</div>
      <div class="text-[13.5px] mb-1.5">Sector 3, Bucharest</div>
      <div class="text-[13.5px] mb-1.5">[[ email ]] · [[ phone ]]</div>
    </div>
    <div>
      <h4 class="font-mono text-[11px] text-text uppercase tracking-[0.08em] mb-3">Group</h4>
      <div class="text-[13.5px] mb-1.5">AS Hiieko — Tallinn, Estonia</div>
      <div class="text-[13.5px] mb-1.5">hiieko.ee</div>
    </div>
    <div>
      <h4 class="font-mono text-[11px] text-text uppercase tracking-[0.08em] mb-3">Legal</h4>
      <div class="text-[13.5px] mb-1.5">CIF 42849908</div>
      <div class="text-[13.5px] mb-1.5">Privacy Policy</div>
    </div>
  </div>
  <div class="wrap flex justify-between text-[12.5px] flex-wrap gap-2.5">
    <span>© {year} Hiieko Romania SRL</span>
    <span>Part of the AS Hiieko group, founded 1994</span>
  </div>
</footer>
