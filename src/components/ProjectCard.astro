---
interface Props {
  title: string;
  category: 'rooftop' | 'ground-mount' | 'bess';
  location: string;
  specLabel: string;
  specValue: string;
  isPlaceholder?: boolean;
}
const { title, category, location, specLabel, specValue, isPlaceholder = false } = Astro.props;

const categoryLabels: Record<string, string> = {
  rooftop: 'Rooftop',
  'ground-mount': 'Ground-mount',
  bess: 'BESS',
};
---

<div
  class:list={[
    'border rounded-md overflow-hidden bg-bg-2 transition-all hover:-translate-y-[3px]',
    isPlaceholder ? 'border-dashed border-line hover:border-neon-dim' : 'border-line hover:border-neon-dim',
  ]}
  data-cat={category}
>
  <div
    class="h-40 relative bg-bg-3"
    style="background-image: repeating-linear-gradient(135deg, rgba(234,242,237,0.05) 0 2px, transparent 2px 14px);"
  >
    {
      isPlaceholder && (
        <span class="absolute top-2.5 left-2.5 font-mono text-[9.5px] bg-neon-dim text-neon px-2 py-1 rounded-sm tracking-[0.05em]">
          PLACEHOLDER
        </span>
      )
    }
  </div>
  <div class="px-5 py-[18px]">
    <div class="font-mono text-[10.5px] text-volt uppercase tracking-[0.06em]">
      {categoryLabels[category]}
    </div>
    <h3 class="text-base my-2 mb-1">{title}</h3>
    <div class="text-[13px] text-muted mb-3">{location}</div>
    <div class="flex justify-between text-[12.5px] border-t border-line pt-2.5">
      <span>{specLabel}</span>
      <span class="font-mono text-text font-semibold">{specValue}</span>
    </div>
  </div>
</div>
