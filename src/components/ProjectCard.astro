---
interface Props {
  title: string;
  category: 'rooftop' | 'ground-mount' | 'bess';
  categoryLabel: string;
  location: string;
  specLabel: string;
  specValue: string;
  specPending?: boolean;
  image?: string;
  isPlaceholder?: boolean;
  placeholderBadge: string;
}
const {
  title,
  category,
  categoryLabel,
  location,
  specLabel,
  specValue,
  specPending = false,
  image,
  isPlaceholder = false,
  placeholderBadge,
} = Astro.props;
---

<div
  class:list={[
    'border-t-2 transition-all hover:-translate-y-[3px]',
    isPlaceholder ? 'border-dashed border-green-mid/60 hover:border-gold' : 'border-green-mid hover:border-gold',
  ]}
  data-cat={category}
>
  <div
    class="h-40 relative overflow-hidden"
    style={image ? undefined : 'background-image: repeating-linear-gradient(135deg, rgba(250,251,247,0.05) 0 2px, transparent 2px 14px);'}
  >
    {
      image ? (
        <img src={image} alt={`Photo of the ${title}`} class="w-full h-full object-cover" loading="lazy" />
      ) : null
    }
    {
      isPlaceholder && (
        <span class="absolute top-2.5 left-2.5 font-mono text-[9.5px] bg-chip text-gold px-2 py-1 rounded-sm tracking-[0.05em]">
          {placeholderBadge}
        </span>
      )
    }
  </div>
  <div class="px-5 py-5">
    <div class="font-mono text-[10.5px] text-gold-bright uppercase tracking-[0.06em]">
      {categoryLabel}
    </div>
    <h3 class="text-base my-2 mb-1 text-white">{title}</h3>
    <div class="text-[13px] text-muted mb-3">{location}</div>
    <div class="flex justify-between text-[12.5px] border-t border-white/10 pt-2.5">
      <span class="text-muted">{specLabel}</span>
      <span
        class:list={[
          'font-mono',
          specPending ? 'text-muted italic' : 'text-white font-semibold',
        ]}
      >
        {specValue}
      </span>
    </div>
  </div>
</div>
