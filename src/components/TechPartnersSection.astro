---
import Eyebrow from './Eyebrow.astro';
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getTranslations(lang);
---

<section class="py-[100px] reveal">
  <div class="wrap">
    <div class="max-w-[640px] mb-[52px]">
      <Eyebrow text={t.techPartners.eyebrow} />
      <h2 class="text-[clamp(26px,3vw,36px)] mt-2.5 mb-3.5">{t.techPartners.h2}</h2>
      <p class="text-muted text-[15.5px]">{t.techPartners.lede}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[26px]">
      {
        t.techPartners.groups.map((group) => (
          <div class="border-t-2 border-green-mid pt-[18px]">
            <h3 class="font-mono text-[11px] text-muted uppercase tracking-[0.06em] mb-4">{group.heading}</h3>
            <ul class="list-none p-0 m-0 flex flex-col gap-3.5">
              {group.items.map((item) => (
                <li class="flex gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0 mt-[7px] shadow-[0_0_6px_var(--color-gold)]" />
                  <div>
                    <div class="text-white text-[14.5px]">{item.name}</div>
                    {item.detail && <div class="text-muted text-[12px] mt-0.5">{item.detail}</div>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
