---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getTranslations(lang);

const links = [
  { href: '/solutions/', label: t.nav.solutions },
  { href: '/#calculator', label: t.nav.calculator },
  { href: '/projects/', label: t.nav.projects },
  { href: '/about/', label: t.nav.about },
  { href: '/team/', label: t.nav.team },
  { href: '/contact/', label: t.nav.contact },
];

// Same canonical-path derivation as BaseLayout, so the toggle always lands
// on the equivalent page in the other language, not just the homepage.
const currentPath = Astro.url.pathname;
const canonicalPath = currentPath.startsWith('/ro/') ? currentPath.slice(3) : currentPath;
const enHref = getRelativeLocaleUrl('en', canonicalPath);
const roHref = getRelativeLocaleUrl('ro', canonicalPath);

function localizedLink(href: string): string {
  if (lang !== 'ro') return href;
  const hashIndex = href.indexOf('#');
  if (hashIndex === -1) return getRelativeLocaleUrl('ro', href);
  // Localize the path portion only — running the hash fragment through
  // trailingSlash normalization would mangle it (e.g. "/#calculator"
  // becoming "/ro/#calculator/", breaking the in-page anchor scroll).
  const path = href.slice(0, hashIndex) || '/';
  const hash = href.slice(hashIndex);
  return getRelativeLocaleUrl('ro', path) + hash;
}
---

<nav
  class="sticky top-0 z-50 bg-charcoal/80 backdrop-blur-[12px]"
>
  <div class="wrap flex items-center justify-between h-[72px]">
    <a href={lang === 'ro' ? '/ro/' : '/'} class="font-display font-extrabold text-[19px] flex items-center gap-2 no-underline text-white">
      <img src="/logo-icon.png" alt="" width="34" height="34" class="w-[34px] h-[34px]" />
      HIIEKO<span class="text-gold">·</span>RO
    </a>
    <div class="hidden lg:flex items-center gap-[30px]">
      {
        links.map((link) => (
          <a
            href={localizedLink(link.href)}
            class="text-muted no-underline text-sm font-medium hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="flex items-center gap-[22px]">
      <div class="hidden lg:flex font-mono text-xs gap-1.5">
        <a href={enHref} class:list={['no-underline', lang === 'en' ? 'text-gold font-bold' : 'text-muted hover:text-white']}>
          EN
        </a>
        <span class="text-muted">/</span>
        <a href={roHref} class:list={['no-underline', lang === 'ro' ? 'text-gold font-bold' : 'text-muted hover:text-white']}>
          RO
        </a>
      </div>
      <a href={localizedLink('/contact/')} class="btn btn-primary btn-compact hidden lg:inline-block">
        {t.nav.cta}
      </a>
      <button
        id="nav-toggle"
        type="button"
        class="lg:hidden flex items-center justify-center w-9 h-9 -mr-1.5 text-white"
        aria-label={t.nav.toggleMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="nav-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg
          id="nav-icon-close"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <line x1="5" y1="5" x2="19" y2="19" />
          <line x1="19" y1="5" x2="5" y2="19" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-white/10 bg-charcoal"
  >
    <div class="wrap flex flex-col py-4">
      <a
        href={lang === 'ro' ? '/ro/' : '/'}
        class="font-display font-extrabold text-[19px] flex items-center gap-2 no-underline py-3 border-b border-white/10 text-white"
      >
        <img src="/logo-icon.png" alt="" width="34" height="34" class="w-[34px] h-[34px]" />
        HIIEKO<span class="text-gold">·</span>RO
      </a>
      {
        links.map((link) => (
          <a
            href={localizedLink(link.href)}
            class="mobile-nav-link text-white no-underline text-base font-medium py-3 border-b border-white/10 last:border-b-0"
          >
            {link.label}
          </a>
        ))
      }
      <div class="flex items-center justify-between pt-4">
        <div class="font-mono text-xs flex gap-1.5">
          <a href={enHref} class:list={['no-underline', lang === 'en' ? 'text-gold font-bold' : 'text-muted']}>
            EN
          </a>
          <span class="text-muted">/</span>
          <a href={roHref} class:list={['no-underline', lang === 'ro' ? 'text-gold font-bold' : 'text-muted']}>
            RO
          </a>
        </div>
        <a href={localizedLink('/contact/')} class="mobile-nav-link btn btn-primary btn-compact">
          {t.nav.cta}
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLDivElement;
  const iconOpen = document.getElementById('nav-icon-open') as HTMLElement;
  const iconClose = document.getElementById('nav-icon-close') as HTMLElement;

  function setOpen(open: boolean): void {
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle.addEventListener('click', () => {
    setOpen(menu.classList.contains('hidden'));
  });

  menu.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  const desktopQuery = window.matchMedia('(min-width: 1024px)');
  desktopQuery.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
