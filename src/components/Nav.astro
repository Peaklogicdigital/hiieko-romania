---
const links = [
  { href: '/solutions/', label: 'Solutions' },
  { href: '/#calculator', label: 'Calculator' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/team/', label: 'Team' },
  { href: '/contact/', label: 'Contact' },
];
---

<nav
  class="sticky top-0 z-50 bg-bg/90 backdrop-blur-[8px] border-b border-line"
>
  <div class="wrap flex items-center justify-between h-[72px]">
    <a href="/" class="font-display font-extrabold text-[19px] flex gap-2 no-underline">
      HIIEKO<span class="text-neon">·</span>RO
    </a>
    <div class="hidden lg:flex items-center gap-[30px]">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-muted no-underline text-sm font-medium hover:text-text"
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="flex items-center gap-[22px]">
      <div class="hidden lg:flex font-mono text-xs text-muted gap-1.5">
        <b class="text-neon">EN</b><span>/</span><span>RO</span>
      </div>
      <a href="/contact/" class="btn btn-ghost px-[18px] py-[10px] hidden lg:inline-block">
        Get a site assessment
      </a>
      <button
        id="nav-toggle"
        type="button"
        class="lg:hidden flex items-center justify-center w-9 h-9 -mr-1.5 text-text"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="nav-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg
          id="nav-icon-close"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <line x1="5" y1="5" x2="19" y2="19" />
          <line x1="19" y1="5" x2="5" y2="19" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-line bg-bg"
  >
    <div class="wrap flex flex-col py-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link text-text no-underline text-base font-medium py-3 border-b border-line last:border-b-0"
          >
            {link.label}
          </a>
        ))
      }
      <div class="flex items-center justify-between pt-4">
        <div class="font-mono text-xs text-muted flex gap-1.5">
          <b class="text-neon">EN</b><span>/</span><span>RO</span>
        </div>
        <a href="/contact/" class="mobile-nav-link btn btn-ghost px-[18px] py-[10px]">
          Get a site assessment
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu') as HTMLDivElement;
  const iconOpen = document.getElementById('nav-icon-open') as HTMLElement;
  const iconClose = document.getElementById('nav-icon-close') as HTMLElement;

  function setOpen(open: boolean): void {
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle.addEventListener('click', () => {
    setOpen(menu.classList.contains('hidden'));
  });

  menu.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  const desktopQuery = window.matchMedia('(min-width: 1024px)');
  desktopQuery.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
