---
// Shared "big gold number + muted label" stat display — used by TrustStrip
// (Home page) and PerformanceSection (Solutions page), which previously
// duplicated this markup independently at two different sizes (22px vs
// 26px) with two different divider treatments. Standardized here on the
// border-t-2 accent already used by the card components (SolutionCard,
// ProjectCard, TeamCard) rather than TrustStrip's old side-border, since a
// top border reads correctly at any column count without the "orphaned
// divider on row 2" problem a side-border has when a grid wraps on mobile
// (the exact bug StatBlock's old lg:-scoped side-border existed to work
// around in the first place).
interface Props {
  value: string;
  label: string;
  countTo?: number;
  suffix?: string;
  // 'xl' exists for TrustStrip's ISO cert stat specifically: it needs to
  // outweigh the Calculator's own output numbers (30px) rather than sit
  // below them, since a verified credential should carry more visual
  // weight than a number a visitor just typed in.
  size?: 'md' | 'lg' | 'xl';
}
const { value, label, countTo, suffix, size = 'md' } = Astro.props;
const sizeClass = size === 'xl' ? 'text-[34px]' : size === 'lg' ? 'text-[26px]' : 'text-[22px]';
---

<div class="border-t-2 border-green-mid pt-[18px]">
  <div class:list={['font-mono text-gold-bright font-semibold', sizeClass]}>
    <span data-count={countTo}>{countTo !== undefined ? '0' : value}</span>{suffix}
  </div>
  <div class="text-muted text-[12.5px] mt-1">{label}</div>
</div>
