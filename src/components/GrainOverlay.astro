---
// Film-grain texture over the page gradient. Static (no animation), so it
// needs no prefers-reduced-motion handling — reduced-motion concerns
// things that move, and this doesn't. Sits at z-0, above body's gradient
// (which isn't part of the stacking order at all — it's the root canvas
// paint) and below real content, which is z-10 throughout this layout.
---

<div class="fixed inset-0 z-0 pointer-events-none" style="opacity: 0.21; mix-blend-mode: hard-light;" aria-hidden="true">
  <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
    <filter id="grain-filter" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch" result="noise" />
      <feColorMatrix
        in="noise"
        type="matrix"
        values="0.33 0.33 0.33 0 0
                0.33 0.33 0.33 0 0
                0.33 0.33 0.33 0 0
                0 0 0 0 1"
        result="greyscale"
      />
      <feComponentTransfer in="greyscale">
        <feFuncR type="gamma" amplitude="1" exponent="0.5" offset="0" />
        <feFuncG type="gamma" amplitude="1" exponent="0.5" offset="0" />
        <feFuncB type="gamma" amplitude="1" exponent="0.5" offset="0" />
      </feComponentTransfer>
    </filter>
    <rect width="100%" height="100%" filter="url(#grain-filter)" />
  </svg>
</div>
