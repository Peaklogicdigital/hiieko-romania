---
// Home-hero-exclusive diagram. Temporarily just the static "fully running
// system" illustration (previously Frame 4 of a 4-frame crossfade, later
// the hold-frame for a video) while a new hero graphic is designed --
// deliberately not animated and with no fallback logic to maintain, since
// there's nothing here to fall back from.
import { Picture } from 'astro:assets';
import frame4 from '../assets/hero-frames/frame-4-full-system.png';
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getTranslations(lang);
---

<Picture
  src={frame4}
  alt={t.heroDiagram.alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpeg"
  widths={[400, 600, 800, 955]}
  sizes="(min-width: 768px) 55vw, 100vw"
  loading="eager"
  class="w-full h-auto"
/>
