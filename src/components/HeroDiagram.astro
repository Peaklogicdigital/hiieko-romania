---
// Home-hero-exclusive animated diagram: sun -> panel -> inverter -> battery
// -> facility, a real video (public/videos/hero-animation.mp4). Video
// lives in public/ instead of src/assets/ because astro:assets' image()
// schema and <Picture>/<Image> only process image formats (avif/webp/jpeg
// conversion + responsive widths) -- there's no equivalent pipeline for
// video, so it needs a fixed URL served as-is, the same way the site's
// favicons already are.
//
// Rendered full-width (previously squeezed into a ~1.15fr grid column
// alongside the hero text, which measured out to well under half the
// hero's actual available width) so it reads as the substantial visual
// the hero needs rather than a small inset. The surrounding vertical
// margin exists specifically to give the cloud callouts room to sit
// above and below the video without the hero feeling cramped.
import { Picture } from 'astro:assets';
import frame4 from '../assets/hero-frames/frame-4-full-system.png';
import CloudCallout from './CloudCallout.astro';
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getTranslations(lang);

// Timings verified frame-by-frame against the actual video (1280x720,
// 8s, 24fps) rather than guessed: the sun/panel glow and the first dashed
// energy-line segment appear ~0.3-2.0s, the inverter's indicator lights at
// ~3.0s once the line reaches it, the battery fills segment-by-segment
// from ~4.8s to a full charge at ~6.0s, and the facility's windows light
// up at ~6.3s and hold through the loop point at 8.0s.
//
// Positions are percentages of the video box, matching where each device
// actually sits in the frame (panel upper-left, inverter/battery upper-
// middle, facility lower-right) -- the panel/inverter/battery callouts
// sit above the video with a downward tail, the facility callout sits
// below with an upward tail, each pointing back at its own device instead
// of overlapping the diagram itself.
const captions = [
  {
    text: t.heroVideo.captions.panel,
    start: 0.3,
    end: 2.0,
    tailDirection: 'down' as const,
    style: 'left: 2%; top: -128px;',
  },
  {
    text: t.heroVideo.captions.inverter,
    start: 2.3,
    end: 4.4,
    tailDirection: 'down' as const,
    style: 'left: 36%; top: -128px;',
  },
  {
    text: t.heroVideo.captions.battery,
    start: 4.5,
    end: 6.2,
    tailDirection: 'down' as const,
    // right-anchored rather than left: X%, since at narrow viewports a
    // left offset placed the box's right edge past the viewport edge
    // (confirmed by measuring its bounding box at 375px). Anchoring from
    // the right keeps it clear of that edge at any width.
    style: 'right: 14%; top: -128px;',
  },
  {
    text: t.heroVideo.captions.building,
    start: 6.3,
    end: 8.0,
    tailDirection: 'up' as const,
    style: 'left: 52%; bottom: -110px;',
  },
];
---

<div class="hero-video-wrap relative mt-[150px] mb-[110px]">
  <div class="hero-video relative w-full" id="hero-video" style="aspect-ratio: 1280 / 720;">
    <video
      id="hero-video-el"
      class="hero-video-media block w-full h-full object-contain"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline="true"
      preload="auto"
      aria-label={t.heroVideo.diagramAlt}
    >
      <source src="/videos/hero-animation.mp4" type="video/mp4" />
    </video>

    <Picture
      src={frame4}
      alt={t.heroVideo.diagramAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      widths={[500, 700, 955, 1180]}
      sizes="90vw"
      loading="eager"
      class="hero-video-fallback absolute inset-0 w-full h-full object-contain"
    />
  </div>

  {
    captions.map((c) => (
      <CloudCallout
        text={c.text}
        tailDirection={c.tailDirection}
        style={c.style}
        dataStart={c.start}
        dataEnd={c.end}
        class="hero-video-caption"
      />
    ))
  }
</div>

<script>
  // Autoplay-blocked and prefers-reduced-motion both fall back to the
  // static Frame 4 image (see .hero-video-fallback below) so nobody ever
  // sees a blank space where the diagram should be. The reduced-motion
  // fallback is handled entirely in CSS (matching every other animation
  // on this site, e.g. .reveal) so it holds even if this script never
  // runs; the autoplay-blocked fallback needs JS because it can only be
  // known by attempting play() and observing whether its promise rejects.
  function initHeroVideo(): void {
    const container = document.getElementById('hero-video');
    const wrap = document.querySelector('.hero-video-wrap');
    const video = document.getElementById('hero-video-el');
    if (!container || !wrap || !(video instanceof HTMLVideoElement)) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return; // CSS alone already shows the static fallback; the captions
              // below are timed to the video's own playback clock, so
              // without the video running there is nothing for them to
              // sync to and they correctly stay off.
    }

    const captionEls = Array.from(wrap.querySelectorAll<HTMLElement>('.hero-video-caption'));

    video.addEventListener('timeupdate', () => {
      const time = video.currentTime;
      captionEls.forEach((el) => {
        const start = Number(el.dataset.start);
        const end = Number(el.dataset.end);
        el.classList.toggle('visible', time >= start && time < end);
      });
    });

    video.muted = true;
    const playPromise = video.play();
    if (playPromise !== undefined) {
      playPromise.catch(() => {
        container.classList.add('show-fallback');
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroVideo);
  } else {
    initHeroVideo();
  }
</script>

<style>
  .hero-video-media {
    /* The source video's own backdrop is a rendered dark scene, not a flat
       matte, and it doesn't match --color-green-dark closely enough to
       read as seamless (confirmed by sampling frame pixels: mostly
       near-black, drifting to a desaturated olive-gray on the ground
       plane -- never the site's more saturated green). screen blends
       nearly-black pixels into whatever is behind the video (here, the
       page's own background) while leaving the bright/saturated content
       -- the sun, the glowing energy line, the lit windows -- fully
       visible on top. Verified directly against mix-blend-mode: lighten,
       which leaves a faint rectangular tint at the video's edges instead
       of blending cleanly. This is the video equivalent of how the
       static frame PNGs solve the same problem: they simply have the
       site's bg color baked into their own background, which isn't
       possible for the video's already-encoded pixels without changing
       the source file. */
    mix-blend-mode: screen;
  }

  .hero-video {
    /* screen blends flawlessly once the scene is lit (verified: the sun,
       panels, and later frames all read as fully seamless), but the
       video's darkest opening moment -- before the sun starts casting
       real light -- is dim enough overall (not just its corners) that
       screening it against the page's own background still left a
       faintly visible box for about the first second of the loop. The
       hero sits within the body gradient's flat --color-green-dark
       stretch (0-15%), so giving this container that same color as its
       own background gives screen a near-identical backdrop to blend
       against right from the start, instead of relying on the page
       gradient showing through from several layers back. */
    background-color: var(--color-green-dark);
  }

  .hero-video-fallback {
    display: none;
  }
  .hero-video.show-fallback .hero-video-media {
    display: none;
  }
  .hero-video.show-fallback .hero-video-fallback {
    display: block;
  }

  /* :global() is required here: these captions are <CloudCallout> instances
     -- a separate component -- so their rendered markup never receives this
     file's Astro scoping attribute, and an unscoped selector would silently
     never match. */
  :global(.hero-video-caption) {
    opacity: 0;
    visibility: hidden;
    transition: opacity 250ms ease;
    pointer-events: none;
  }
  :global(.hero-video-caption.visible) {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-media {
      display: none;
    }
    .hero-video-fallback {
      display: block;
    }
    :global(.hero-video-caption) {
      transition: none;
    }
  }
</style>
