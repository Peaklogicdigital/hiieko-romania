---
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getTranslations(lang);
const webhookUrl = import.meta.env.PUBLIC_CONTACT_WEBHOOK_URL ?? '';
---

<form
  id="contact-form"
  class="grid gap-3.5"
  data-webhook-url={webhookUrl}
  data-status-not-configured={t.contactForm.statusNotConfigured}
  data-status-sending={t.contactForm.statusSending}
  data-status-success={t.contactForm.statusSuccess}
  data-status-error={t.contactForm.statusError}
>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
    <div>
      <label for="nume" class="block font-mono text-[11px] text-muted tracking-[0.05em] uppercase mb-1.5">{t.contactForm.nameLabel}</label>
      <input id="nume" name="name" type="text" required class="w-full bg-bg-2 border border-line text-text px-[13px] py-3 text-sm rounded-[3px] focus:outline-2 focus:outline-neon focus:border-neon" />
    </div>
    <div>
      <label for="companie" class="block font-mono text-[11px] text-muted tracking-[0.05em] uppercase mb-1.5">{t.contactForm.companyLabel}</label>
      <input id="companie" name="company" type="text" required class="w-full bg-bg-2 border border-line text-text px-[13px] py-3 text-sm rounded-[3px] focus:outline-2 focus:outline-neon focus:border-neon" />
    </div>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
    <div>
      <label for="email" class="block font-mono text-[11px] text-muted tracking-[0.05em] uppercase mb-1.5">{t.contactForm.emailLabel}</label>
      <input id="email" name="email" type="email" required class="w-full bg-bg-2 border border-line text-text px-[13px] py-3 text-sm rounded-[3px] focus:outline-2 focus:outline-neon focus:border-neon" />
    </div>
    <div>
      <label for="tel" class="block font-mono text-[11px] text-muted tracking-[0.05em] uppercase mb-1.5">{t.contactForm.phoneLabel}</label>
      <input id="tel" name="phone" type="tel" class="w-full bg-bg-2 border border-line text-text px-[13px] py-3 text-sm rounded-[3px] focus:outline-2 focus:outline-neon focus:border-neon" />
    </div>
  </div>
  <div>
    <label for="tip" class="block font-mono text-[11px] text-muted tracking-[0.05em] uppercase mb-1.5">{t.contactForm.projectTypeLabel}</label>
    <select id="tip" name="projectType" class="w-full bg-bg-2 border border-line text-text px-[13px] py-3 text-sm rounded-[3px] focus:outline-2 focus:outline-neon focus:border-neon">
      <option>{t.contactForm.projectTypeOptions.rooftop}</option>
      <option>{t.contactForm.projectTypeOptions.groundMount}</option>
      <option>{t.contactForm.projectTypeOptions.bess}</option>
      <option>{t.contactForm.projectTypeOptions.notSure}</option>
    </select>
  </div>
  <div>
    <label for="mesaj" class="block font-mono text-[11px] text-muted tracking-[0.05em] uppercase mb-1.5">{t.contactForm.messageLabel}</label>
    <textarea id="mesaj" name="message" class="w-full bg-bg-2 border border-line text-text px-[13px] py-3 text-sm rounded-[3px] min-h-[90px] resize-y focus:outline-2 focus:outline-neon focus:border-neon"></textarea>
  </div>
  <button type="submit" class="btn btn-primary justify-self-start">{t.contactForm.submitBtn}</button>
  <p id="contact-status" class="font-mono text-[12.5px] text-muted min-h-[1em]" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('contact-status') as HTMLParagraphElement;
  const webhookUrl = form.dataset.webhookUrl || '';
  const statusNotConfigured = form.dataset.statusNotConfigured || '';
  const statusSending = form.dataset.statusSending || '';
  const statusSuccess = form.dataset.statusSuccess || '';
  const statusError = form.dataset.statusError || '';

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!webhookUrl) {
      status.textContent = statusNotConfigured;
      status.classList.remove('text-neon');
      status.classList.add('text-muted');
      return;
    }

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    status.textContent = statusSending;
    status.classList.remove('text-neon');
    status.classList.add('text-muted');

    try {
      const res = await fetch(webhookUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(`Request failed: ${res.status}`);
      status.textContent = statusSuccess;
      status.classList.remove('text-muted');
      status.classList.add('text-neon');
      form.reset();
    } catch {
      status.textContent = statusError;
      status.classList.remove('text-neon');
      status.classList.add('text-muted');
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
