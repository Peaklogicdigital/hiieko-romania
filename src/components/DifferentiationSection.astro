---
import Eyebrow from './Eyebrow.astro';
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getTranslations(lang);
const steps = t.diff.steps;
---

<section class="py-[100px] reveal">
  <div class="wrap">
    <div class="max-w-[640px] mb-[52px]">
      <Eyebrow text={t.diff.eyebrow} />
      <h2 class="text-[clamp(26px,3vw,36px)] mt-2.5 mb-3.5">
        {t.diff.h2}
      </h2>
      <p class="text-muted text-[15.5px]">
        {t.diff.lede}
      </p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-y-[26px] md:gap-y-0 border-t border-line">
      {
        // desktop: border-right on all but the last; mobile (2 cols): border-right
        // dropped on the last item of each row (index 1 and 3)
        steps.map((step, i) => {
          const borderClasses = [0, 2].includes(i)
            ? 'border-r border-line'
            : i === 1
              ? 'md:border-r md:border-line'
              : '';
          return (
            <div class:list={['pt-[30px] pr-[26px] pb-0', borderClasses]}>
              <span class="font-mono text-volt text-[12.5px] font-semibold mb-3 block">
                {step.n}
              </span>
              <h3 class="text-[16.5px] mb-2">{step.title}</h3>
              <p class="text-[13.5px] text-muted max-w-[30ch]">{step.body}</p>
            </div>
          );
        })
      }
    </div>
    <div
      class="mt-[46px] py-6 px-7 bg-bg-2 border border-neon-dim border-l-[3px] border-l-neon text-[15.5px] text-text rounded-[2px]"
    >
      {t.diff.callout}
    </div>
  </div>
</section>
