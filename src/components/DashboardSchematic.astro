---

<svg
  class="w-full h-auto"
  viewBox="0 0 520 300"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Energy flow diagram: sun, solar panel, inverter, battery, facility and grid"
>
  <path
    class="fill-none stroke-volt stroke-[1.6px] opacity-55"
    stroke-dasharray="5 5"
    d="M70,70 L150,70 L150,130"
  />
  <path
    class="fill-none stroke-volt stroke-[1.6px] opacity-55"
    stroke-dasharray="5 5"
    d="M150,150 L230,150"
  />
  <path
    class="fill-none stroke-volt stroke-[1.6px] opacity-55"
    stroke-dasharray="5 5"
    d="M270,150 L340,150"
  />
  <path
    class="fill-none stroke-volt stroke-[1.6px] opacity-55"
    stroke-dasharray="5 5"
    d="M380,150 L380,110 L440,80"
  />
  <path
    class="fill-none stroke-volt stroke-[1.6px] opacity-55"
    stroke-dasharray="5 5"
    d="M380,150 L380,200 L440,230"
  />

  <circle cx="70" cy="70" r="22" class="fill-none stroke-muted stroke-[1.2px]" />
  <circle cx="70" cy="70" r="6" fill="var(--color-neon)" filter="drop-shadow(0 0 5px var(--color-neon))" />
  <text x="70" y="112" text-anchor="middle" class="font-mono fill-muted text-[10px] tracking-[0.04em] uppercase">Sun</text>

  <rect x="128" y="128" width="44" height="30" rx="2" class="fill-none stroke-muted stroke-[1.2px]" />
  <text x="150" y="176" text-anchor="middle" class="font-mono fill-muted text-[10px] tracking-[0.04em] uppercase">PV Panel</text>

  <rect x="230" y="132" width="40" height="36" rx="2" class="fill-none stroke-muted stroke-[1.2px]" />
  <text x="250" y="188" text-anchor="middle" class="font-mono fill-muted text-[10px] tracking-[0.04em] uppercase">Inverter</text>

  <rect x="340" y="130" width="40" height="40" rx="2" class="fill-none stroke-muted stroke-[1.2px]" />
  <line x1="352" y1="138" x2="352" y2="162" stroke="var(--color-muted)" stroke-width="1.2" />
  <line x1="368" y1="138" x2="368" y2="162" stroke="var(--color-muted)" stroke-width="1.2" />
  <text x="360" y="188" text-anchor="middle" class="font-mono fill-muted text-[10px] tracking-[0.04em] uppercase">Battery</text>

  <rect x="438" y="58" width="46" height="34" rx="2" class="fill-none stroke-muted stroke-[1.2px]" />
  <text x="461" y="46" text-anchor="middle" class="font-mono fill-muted text-[10px] tracking-[0.04em] uppercase">Facility</text>

  <circle cx="461" cy="230" r="20" class="fill-none stroke-muted stroke-[1.2px]" />
  <text x="461" y="266" text-anchor="middle" class="font-mono fill-muted text-[10px] tracking-[0.04em] uppercase">Grid</text>

  <circle r="3.2" class="fill-neon" filter="drop-shadow(0 0 5px var(--color-neon))">
    <animateMotion dur="3.2s" repeatCount="indefinite" path="M70,70 L150,70 L150,130 L150,150 L230,150 L270,150 L340,150" />
  </circle>
  <circle r="3.2" class="fill-neon" filter="drop-shadow(0 0 5px var(--color-neon))">
    <animateMotion dur="3.2s" begin="1.6s" repeatCount="indefinite" path="M380,150 L380,110 L440,80" />
  </circle>
  <circle r="3.2" class="fill-neon" filter="drop-shadow(0 0 5px var(--color-neon))">
    <animateMotion dur="3.2s" begin="2.4s" repeatCount="indefinite" path="M380,150 L380,200 L440,230" />
  </circle>
</svg>
