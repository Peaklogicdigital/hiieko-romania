---
import type { Lang } from '../i18n/ui';
import { CONTACT_MAP_EMBED_URL, defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = getTranslations(lang);
---

<div class="mt-6 rounded-md border border-white/10 overflow-hidden aspect-video">
  <iframe
    src={CONTACT_MAP_EMBED_URL}
    width="100%"
    height="100%"
    style="border:0;display:block;"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={t.contactMap.title}
  ></iframe>
</div>
