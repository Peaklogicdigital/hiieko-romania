---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  filterable?: boolean;
  limit?: number;
  lang?: Lang;
}
const { filterable = false, limit, lang = defaultLang } = Astro.props;
const t = getTranslations(lang);

let projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
if (limit) projects = projects.slice(0, limit);

const filters = [
  { f: 'all', label: t.projectsFilters.all },
  { f: 'rooftop', label: t.projectsFilters.rooftop },
  { f: 'ground-mount', label: t.projectsFilters.groundMount },
  { f: 'bess', label: t.projectsFilters.bess },
];

const categoryLabels: Record<string, string> = {
  rooftop: t.projectsFilters.rooftop,
  'ground-mount': t.projectsFilters.groundMount,
  bess: t.projectsFilters.bess,
};

// Draft AI-assisted translation of project spec labels/values, pending
// native-speaker review before launch. Most specValue entries are
// language-neutral numbers/units (e.g. "150 kWp") and pass through
// unchanged; only the "pending" placeholder text needs translating.
const specLabelTranslations: Record<string, string> =
  lang === 'ro' ? { Capacity: 'Capacitate', Storage: 'Stocare' } : {};
const specValueTranslations: Record<string, string> =
  lang === 'ro' ? { 'Pending: confirm with team': 'În așteptare: de confirmat cu echipa' } : {};
---

<div>
  {
    filterable && (
      <div class="flex gap-2.5 mb-9 flex-wrap">
        {filters.map((item, i) => (
          <button
            type="button"
            class:list={[
              'filter-btn bg-transparent border border-white/10 text-muted px-4 py-[9px] text-xs font-mono uppercase',
              i === 0 && 'active border-gold! text-gold!',
            ]}
            data-f={item.f}
          >
            {item.label}
          </button>
        ))}
      </div>
    )
  }
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[22px]" id="proj-grid">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          category={project.data.category}
          categoryLabel={categoryLabels[project.data.category]}
          location={project.data.location}
          specLabel={specLabelTranslations[project.data.specLabel] ?? project.data.specLabel}
          specValue={specValueTranslations[project.data.specValue] ?? project.data.specValue}
          specPending={project.data.specPending}
          image={project.data.image}
          isPlaceholder={project.data.isPlaceholder}
          placeholderBadge={t.common.placeholderBadge}
        />
      ))
    }
  </div>
</div>

{
  filterable && (
    <script>
      const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
      const projCards = document.querySelectorAll<HTMLElement>('#proj-grid [data-cat]');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => {
            b.classList.remove('active', 'border-gold!', 'text-gold!');
          });
          btn.classList.add('active', 'border-gold!', 'text-gold!');
          const f = btn.dataset.f;
          projCards.forEach((card) => {
            const show = f === 'all' || card.dataset.cat === f;
            card.style.display = show ? '' : 'none';
          });
        });
      });
    </script>
  )
}
