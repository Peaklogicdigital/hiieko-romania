---
interface Props {
  text: string;
  small?: boolean;
}
const { text, small = false } = Astro.props;
---

<span
  class:list={[
    'font-mono uppercase text-neon font-semibold flex items-center gap-2',
    small ? 'text-[10px]' : 'text-xs tracking-[0.14em]',
  ]}
>
  <span
    class="w-1.5 h-1.5 rounded-full bg-neon shadow-[0_0_8px_var(--color-neon)] animate-blink motion-reduce:animate-none"
  ></span>
  {text}
</span>
