---
interface Props {
  name: string;
  role: string;
  phone?: string;
  email?: string;
  photo?: string;
  isPlaceholder?: boolean;
  placeholderBadge: string;
}
const { name, role, phone, email, photo, isPlaceholder = false, placeholderBadge } = Astro.props;

const initials = name
  .replace(/[[\]]/g, '')
  .trim()
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

const telHref = phone?.replace(/[\s()-]/g, '');
const photoAlt = photo ? `Photo of ${name}, ${role} at Hiieko Romania` : undefined;
---

<div
  class:list={[
    'border rounded-md overflow-hidden bg-bg-2 transition-all hover:-translate-y-[3px]',
    isPlaceholder ? 'border-dashed border-line hover:border-neon-dim' : 'border-line hover:border-neon-dim',
  ]}
>
  <div
    class="aspect-square relative bg-bg-3 flex items-center justify-center overflow-hidden"
    style={photo ? undefined : 'background-image: repeating-linear-gradient(135deg, rgba(234,242,237,0.05) 0 2px, transparent 2px 14px);'}
  >
    {
      photo ? (
        <img src={photo} alt={photoAlt} class="w-full h-full object-cover object-top" loading="lazy" />
      ) : (
        <span class="font-display font-extrabold text-3xl text-muted">{initials || '—'}</span>
      )
    }
    {
      isPlaceholder && (
        <span class="absolute top-2.5 left-2.5 font-mono text-[9.5px] bg-neon-dim text-neon px-2 py-1 rounded-sm tracking-[0.05em]">
          {placeholderBadge}
        </span>
      )
    }
  </div>
  <div class="px-5 py-5 flex flex-col gap-1.5">
    <h3 class="text-base m-0">{name}</h3>
    <div class="font-mono text-[10.5px] text-volt uppercase tracking-[0.06em]">{role}</div>
    {phone && (
      <a href={`tel:${telHref}`} class="text-neon underline text-[13px]">
        {phone}
      </a>
    )}
    {email && (
      <a href={`mailto:${email}`} class="text-neon underline text-[13px]">
        {email}
      </a>
    )}
  </div>
</div>
