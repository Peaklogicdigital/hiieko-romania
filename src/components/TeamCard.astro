---
interface Props {
  name: string;
  role: string;
  bio?: string;
  isPlaceholder?: boolean;
  placeholderBadge: string;
}
const { name, role, bio, isPlaceholder = false, placeholderBadge } = Astro.props;

const initials = name
  .replace(/[[\]]/g, '')
  .trim()
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<div
  class:list={[
    'border rounded-md overflow-hidden bg-bg-2 transition-all hover:-translate-y-[3px]',
    isPlaceholder ? 'border-dashed border-line hover:border-neon-dim' : 'border-line hover:border-neon-dim',
  ]}
>
  <div
    class="h-40 relative bg-bg-3 flex items-center justify-center"
    style="background-image: repeating-linear-gradient(135deg, rgba(234,242,237,0.05) 0 2px, transparent 2px 14px);"
  >
    <span class="font-display font-extrabold text-3xl text-muted">{initials || '—'}</span>
    {
      isPlaceholder && (
        <span class="absolute top-2.5 left-2.5 font-mono text-[9.5px] bg-neon-dim text-neon px-2 py-1 rounded-sm tracking-[0.05em]">
          {placeholderBadge}
        </span>
      )
    }
  </div>
  <div class="px-5 py-[18px]">
    <div class="font-mono text-[10.5px] text-volt uppercase tracking-[0.06em]">{role}</div>
    <h3 class="text-base my-2 mb-1">{name}</h3>
    {bio && <p class="text-[13px] text-muted mt-2 mb-0">{bio}</p>}
  </div>
</div>
