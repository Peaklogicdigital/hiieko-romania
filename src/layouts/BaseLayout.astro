---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TextureOverlay from '../components/TextureOverlay.astro';
import CookieConsent from '../components/CookieConsent.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import type { Lang } from '../i18n/ui';
import { defaultLang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article' | 'profile';
  lang?: Lang;
}
const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  lang = defaultLang,
} = Astro.props;

// The /ro/ tree is an exact mirror of the default (unprefixed) EN tree, so
// the canonical path for hreflang purposes is just the current path with
// any leading /ro/ stripped.
const currentPath = Astro.url.pathname;
const canonicalPath = currentPath.startsWith('/ro/') ? currentPath.slice(3) : currentPath;
const enHref = getRelativeLocaleUrl('en', canonicalPath);
const roHref = getRelativeLocaleUrl('ro', canonicalPath);

// Structured data is language-independent (machine-facing, not a rendered
// translation), so it uses one canonical set of business details regardless
// of `lang` — same object on every page via this shared layout.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Hiieko Romania SRL',
  url: 'https://hiiekoromania.com',
  logo: 'https://hiiekoromania.com/logo-icon.png',
  email: 'bogdan.otelea@hiieko.ro',
  telephone: '+40 077 563 9026',
  taxID: '42849908',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Bulevardul Theodor Pallady 51N, Building C1, Block A, 3rd floor',
    addressLocality: 'Bucharest',
    addressRegion: 'Sector 3',
    postalCode: '032258',
    addressCountry: 'RO',
  },
  areaServed: 'Romania',
  sameAs: ['https://hiieko.ee'],
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'certification',
      name: 'ISO 9001:2015',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'certification',
      name: 'ISO 14001:2015',
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ro" href={roHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="m-0 relative">
    <TextureOverlay />
    <Nav lang={lang} />
    <main class="relative z-10">
      <slot />
    </main>
    <div class="relative z-10">
      <Footer lang={lang} />
    </div>

    <CookieConsent lang={lang} />

    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
    <SpeedInsights />
    <Analytics />
  </body>
</html>
