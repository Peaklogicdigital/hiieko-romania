---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TextureOverlay from '../components/TextureOverlay.astro';
import CookieConsent from '../components/CookieConsent.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';
import type { Lang } from '../i18n/ui';
import { defaultLang, getTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  lang?: Lang;
}
const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  ogImage = '/og-default.png',
  lang = defaultLang,
} = Astro.props;
const t = getTranslations(lang);

// The /ro/ tree is an exact mirror of the default (unprefixed) EN tree, so
// the canonical path for hreflang purposes is just the current path with
// any leading /ro/ stripped.
const currentPath = Astro.url.pathname;
const canonicalPath = currentPath.startsWith('/ro/') ? currentPath.slice(3) : currentPath;
// Absolute, not relative: hreflang should name the host explicitly (the
// www host from `site` in astro.config.mjs), not rely on the browser
// resolving a bare path against whatever host served the page.
const enHref = getAbsoluteLocaleUrl('en', canonicalPath);
const roHref = getAbsoluteLocaleUrl('ro', canonicalPath);

// Self-referencing canonical: each language's own URL, not the EN original.
const canonicalUrl = new URL(currentPath, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const ogLocale = lang === 'ro' ? 'ro_RO' : 'en_US';
const ogLocaleAlternate = lang === 'ro' ? 'en_US' : 'ro_RO';

// Structured data is language-independent (machine-facing, not a rendered
// translation), so it uses one canonical set of business details regardless
// of `lang` — same object on every page via this shared layout. Contact
// values are read from the i18n dictionary (src/i18n/ui.ts) rather than
// hardcoded here, so there is a single source of truth for them.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Hiieko Romania SRL',
  url: new URL('/', Astro.site).toString(),
  logo: new URL('/logo-icon.png', Astro.site).toString(),
  email: t.contact.email,
  telephone: t.contact.phone,
  taxID: '42849908',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Bulevardul Theodor Pallady 51N, Building C1, Block A, 3rd floor',
    addressLocality: 'Bucharest',
    addressRegion: 'Sector 3',
    postalCode: '032258',
    addressCountry: 'RO',
  },
  areaServed: 'Romania',
  sameAs: ['https://hiieko.ee'],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      name: 'Bogdan Otelea',
      email: t.contact.email,
      telephone: t.contact.phone,
      contactType: 'sales',
      areaServed: 'RO',
      availableLanguage: ['Romanian', 'English'],
    },
    {
      '@type': 'ContactPoint',
      name: 'Laurentiu Oprea',
      email: t.contact.email2,
      telephone: t.contact.phone2,
      contactType: 'sales',
      areaServed: 'RO',
      availableLanguage: ['Romanian', 'English'],
    },
  ],
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'certification',
      name: 'ISO 9001:2015',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'certification',
      name: 'ISO 14001:2015',
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // First-visit language auto-detection, run as early and synchronously
      // as possible (before any content paints) to keep the redirect flash
      // as close to imperceptible as this static, adapter-less deployment
      // allows -- there's no server/edge runtime in front of this site to
      // do the equivalent detection before the response is even sent.
      // Once a visitor has an explicit choice stored (set by the nav
      // EN/RO toggle, see Nav.astro), this never runs again: a manual
      // choice is never second-guessed by auto-detection, no matter what
      // the browser's language setting says later.
      (function () {
        try {
          if (localStorage.getItem('hiieko_lang')) return;
          var path = window.location.pathname;
          if (path === '/ro' || path.indexOf('/ro/') === 0) return;
          // Paid traffic (Google Ads click IDs or any utm_ campaign param)
          // must land exactly where the ad points, not get bounced to /ro/
          // on top of it.
          if (/[?&](gclid|gbraid|wbraid|utm_[a-z_]+)=/i.test(window.location.search)) return;
          var langs =
            navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || ''];
          var prefersRomanian = langs.some(function (l) {
            return /^ro\b/i.test(l);
          });
          if (prefersRomanian) {
            window.location.replace('/ro' + path + window.location.search + window.location.hash);
          }
        } catch (e) {
          // localStorage unavailable (privacy mode, disabled storage) --
          // fail open to English rather than block rendering.
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#092519" />
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Hiieko Romania" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ro" href={roHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="m-0 relative">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-gold focus:text-charcoal focus:px-4 focus:py-2 focus:rounded-[3px] focus:font-mono focus:text-sm focus:font-semibold"
    >
      {t.nav.skipToContent}
    </a>
    <TextureOverlay />
    <Nav lang={lang} />
    <main id="main-content" class="relative z-10">
      <slot />
    </main>
    <div class="relative z-10">
      <Footer lang={lang} />
    </div>

    <CookieConsent lang={lang} />

    <SpeedInsights />
    <Analytics />
  </body>
</html>
