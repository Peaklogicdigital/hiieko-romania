# URL the contact form POSTs a JSON payload to (Slack/Zapier/Make/Formspree/etc.).
# Leave empty locally — the form will show a "not configured" message instead
# of making a network request.
PUBLIC_CONTACT_WEBHOOK_URL=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty locally — the cookie
# consent banner still works, but Accept won't load any analytics script
# without a real ID configured.
PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion ID (e.g. AW-XXXXXXXXXX) and the conversion label for
# the "generate_lead" conversion action (the part after the slash in the
# conversion tag Google Ads gives you, e.g. AW-XXXXXXXXXX/AbC-D_efG-h12).
# Both optional — leave empty and no Ads tag or conversion ever fires.
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
